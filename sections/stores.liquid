{{ 'section-store.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

<script>
  (function () {
    const initStoreCollapse = () => {
      document.querySelectorAll('.store__toggle').forEach((toggle) => {
        toggle.addEventListener('click', function () {
          const parent = this.parentElement;
          const answer = this.nextElementSibling;
          const icon = this.querySelector('.store__icon svg');

          if (!parent.classList.contains('active')) {
            // Close other active blocks in the same section
            const siblings = parent.parentElement.querySelectorAll('.store__description--block.active');
            siblings.forEach((sibling) => {
              sibling.classList.remove('active');
              const siblingAnswer = sibling.querySelector('.store__answer');
              if (siblingAnswer) {
                $(siblingAnswer).stop().slideUp(300);
              }
            });

            parent.classList.add('active');
            $(answer).stop().slideDown(300);
          } else {
            parent.classList.remove('active');
            $(answer).stop().slideUp(300);
          }
        });
      });
    };

    document.addEventListener('DOMContentLoaded', initStoreCollapse);
    document.addEventListener('shopify:section:load', initStoreCollapse);
  })();
</script>

<div class="store container section-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    {% render 'section-header', section_heading_tag: section.settings.heading_tag %}
  {% endif %}

  <div class="store__item">
    <div class="store__description">
      {% for block in section.blocks %}
        {% if block.type == 'store-description' %}
          {% if block.settings.heading != blank or block.settings.description != blank %}
            <div
              class="store__description--block {% if block.settings.default_open %} active {% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="store__toggle">
                <div class="store__toggle-group">
                  {% if block.settings.heading != blank %}
                    {% assign subheading_tag = block.settings.subheading_tag %}
                    <{{ subheading_tag }} class="store__description--heading {{ block.settings.heading_size }}">
                      {{- block.settings.heading -}}
                    </{{ subheading_tag }}>
                  {% endif %}
                </div>
                <div class="store__icon">
                  {% render 'icon-caret' %}
                </div>
              </div>

              <div
                class="store__answer"
                {% if block.settings.default_open %}
                  style="display: block;"
                {% endif %}
              >
                <div class="store__answer-inner">
                  <div class="store__answer-info">
                    {% if block.settings.subheading != blank %}
                      <p class="store__description--subheading subtitle {% if block.settings.heading == blank %} no_heading {% endif %}">
                        {{ block.settings.subheading }}
                      </p>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <div class="store__description--description">{{ block.settings.description }}</div>
                    {% endif %}
                  </div>

                  {% if block.settings.image != blank %}
                    <div class="store__answer-image store__image-wrapper--{{ block.settings.image_ratio }}">
                      {{
                        block.settings.image
                        | image_url: width: 3840
                        | image_tag:
                          class: 'store__image',
                          loading: 'lazy',
                          width: block.settings.image.width,
                          widths: '375, 550, 750, 1100'
                      }}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

