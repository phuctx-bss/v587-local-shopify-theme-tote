{{ 'section-store.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

<script>
  (function () {
    const initStoreFilters = () => {
      const provinceSelect = document.getElementById('Filter-Province-{{ section.id }}');
      const citySelect = document.getElementById('Filter-City-{{ section.id }}');
      if (!provinceSelect || !citySelect) return;
      const cityOptions = Array.from(citySelect.options).filter((opt) => opt.value !== '');

      const filterStores = () => {
        const provinceHandle = provinceSelect.value;
        const cityHandle = citySelect.value;
        const blocks = document.querySelectorAll('.store__description--block');
        const noResults = document.querySelector('.store__no-results');

        let anyVisible = false;
        blocks.forEach((block) => {
          const blockProvince = block.dataset.province;
          const blockCity = block.dataset.city;

          let show = true;
          if (provinceHandle && blockProvince !== provinceHandle) {
            show = false;
          }
          if (cityHandle && blockCity !== cityHandle) {
            show = false;
          }

          block.style.display = show ? 'block' : 'none';
          if (show) anyVisible = true;
        });

        if (noResults) {
          if (anyVisible) {
            noResults.classList.add('hidden');
          } else {
            noResults.classList.remove('hidden');
          }
        }
      };

      provinceSelect.addEventListener('change', function () {
        const provinceHandle = this.value;
        citySelect.innerHTML = '<option value="">City</option>';

        if (!provinceHandle) {
          citySelect.disabled = true;
          citySelect.value = '';
        } else {
          citySelect.disabled = false;
          const filteredOptions = cityOptions.filter((opt) => opt.dataset.province === provinceHandle);
          filteredOptions.forEach((opt) => citySelect.add(opt.cloneNode(true)));
          citySelect.value = '';
        }
        filterStores();
      });

      citySelect.addEventListener('change', filterStores);
    };

    document.addEventListener('DOMContentLoaded', initStoreFilters);
    document.addEventListener('shopify:section:load', initStoreFilters);
  })();
</script>

<div class="store container section-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    {% render 'section-header', section_heading_tag: section.settings.heading_tag %}
  {% endif %}

  <p class="store__filters-title">{{ 'sections.stores.filters_title' | t }}</p>
  <div class="store__filters">
    <div class="store__filter-item">
      <div class="select">
        <select id="Filter-Province-{{ section.id }}" class="select__select">
          <option value="">Province</option>
          {% for province in shop.metaobjects.province.values %}
            <option value="{{ province.system.handle }}">{{ province.name }}</option>
          {% endfor %}
        </select>
        {% render 'icon-caret' %}
      </div>
    </div>
    <div class="store__filter-item">
      <div class="select">
        <select id="Filter-City-{{ section.id }}" class="select__select" disabled>
          <option value="">City</option>
          {% for city in shop.metaobjects.city.values %}
            <option value="{{ city.system.handle }}" data-province="{{ city.province.value.system.handle }}">
              {{ city.name }}
            </option>
          {% endfor %}
        </select>
        {% render 'icon-caret' %}
      </div>
    </div>
  </div>

  <div class="store__item">
    <div class="store__description">
      {% for store in shop.metaobjects.store_locator.values %}
        <div
          class="store__description--block"
          data-province="{{ store.city.value.province.value.system.handle }}"
          data-city="{{ store.city.value.system.handle }}"
        >
          <div class="store__header">
            <h3 class="store__name {{ section.settings.heading_size }}">
              {{- store.name -}}
            </h3>
            {% if store.directions != blank %}
              <a href="{{ store.directions }}" class="store__directions link underlined-link" target="_blank">
                Get directions
              </a>
            {% endif %}
          </div>

          <div class="store__info">
            {% if store.address != blank %}
              <p class="store__address">
                {{ store.address }}
              </p>
            {% endif %}
            {% if store.description != blank %}
              <div class="store__description--content">{{ store.description | metafield_tag }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
      <p class="store__no-results hidden">{{ 'sections.stores.no_results' | t }}</p>
    </div>
  </div>
</div>

