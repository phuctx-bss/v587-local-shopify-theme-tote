{
  "sections": {
    "main": {
      "type": "main-article",
      "blocks": {
        "title": {
          "type": "article-header",
          "settings": {
            "blog_show_tags": true,
            "blog_show_excerpt": true,
            "blog_show_author": true,
            "blog_show_date": true,
            "image_height": "large"
          }
        },
        "content": {
          "type": "content",
          "settings": {
            "blog_show_author": false,
            "blog_show_tags": true,
            "blog_show_date": true,
            "show_share": true,
            "show_social_icons": false,
            "share_label": "Share",
            "show_share_facebook": true,
            "show_share_twitter": true,
            "show_share_pinterest": true,
            "show_share_copy": true
          }
        }
      },
      "block_order": [
        "title",
        "content"
      ],
      "custom_css": [
        ".article-template__content-rte h2 b {font-weight: inherit;}"
      ],
      "settings": {
        "header_variant": "column",
        "previous_next_links": true,
        "margin_top": "no-indent",
        "margin_bottom": "m"
      }
    }
  },
  "order": [
    "main"
  ]
}
